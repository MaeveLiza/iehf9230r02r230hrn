import hashlib

def hash_file(path):

    sha = hashlib.sha3_512()

    with open(path, "rb") as f:

        while chunk := f.read(4096):
            sha.update(chunk)

    return sha.hexdigest()

import psutil

WATCHLIST = [
    "keylogger",
    "sniffer",
    "remote_access"
]

def detect_intrusions():

    alerts = []

    for proc in psutil.process_iter(['name']):

        try:

            name = proc.info['name']

            if name:

                lowered = name.lower()

                for item in WATCHLIST:

                    if item in lowered:

                        alerts.append(name)

        except:
            pass

    return alerts

